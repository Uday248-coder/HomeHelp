generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkerType {
  home_help
  driver
  both
}

enum BookingMode {
  home_help
  driver
  driver_outstation
}

enum BookingStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

enum PaymentStatus {
  pending
  captured
  paid
  refunded
}

enum PayoutStatus {
  pending
  processed
  failed
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  password        String
  name            String?
  phoneNumber     String?   @unique @map("phone_number")
  profilePhotoUrl String?   @map("profile_photo_url")
  walletBalance   Decimal   @default(0) @map("wallet_balance")
  isAdmin         Boolean   @default(false) @map("is_admin")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  bookings        Booking[]
  workers         Worker[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

enum VerificationStatus {
  not_started
  pending
  in_progress
  verified
  failed
  manual_review
  expired
}

model Worker {
  id               String       @id @default(uuid()) @db.Uuid
  workerType       WorkerType   @map("worker_type")
  name             String
  experience       String?      @map("experience")
  phoneNumber      String?      @unique @map("phone_number")
  userId           String?      @unique @db.Uuid @map("user_id")
  user             User?        @relation(fields: [userId], references: [id])
  photoUrl         String?      @map("photo_url")
  aadhaarVerified  Boolean      @default(false) @map("aadhaar_verified")
  licenseVerified  Boolean      @default(false) @map("license_verified")
  averageRating    Decimal      @default(0) @map("average_rating")
  totalJobs        Int          @default(0) @map("total_jobs")
  isAvailable      Boolean      @default(true) @map("is_available")
  isActive         Boolean      @default(true) @map("is_active")
  deactivationReason String?    @map("deactivation_reason")
  currentLat       Decimal?     @map("current_lat") @db.Decimal(10, 7)
  currentLng       Decimal?     @map("current_lng") @db.Decimal(10, 7)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  bookings         Booking[]
  payouts          WorkerPayout[]
  kycVerifications KycVerification[]
  kycAuditLogs     KycAuditLog[]

  @@map("workers")
}

model KycVerification {
  id                String              @id @default(uuid()) @db.Uuid
  workerId          String              @map("worker_id") @db.Uuid
  verificationType  String              @map("verification_type")
  status            VerificationStatus  @default(not_started)
  provider          String?
  providerRefId     String?             @map("provider_ref_id")
  maskedIdentifier  String?             @map("masked_identifier")
  nameOnDocument    String?             @map("name_on_document")
  dobOnDocument     DateTime?           @map("dob_on_document")
  documentExpiry    DateTime?           @map("document_expiry")
  vehicleClasses    String?             @map("vehicle_classes")
  failureReason     String?             @map("failure_reason")
  reviewedByAdminId String?             @map("reviewed_by_admin_id") @db.Uuid
  reviewNotes       String?             @map("review_notes")
  consentTimestamp  DateTime?           @map("consent_timestamp")
  verifiedAt        DateTime?           @map("verified_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  worker            Worker              @relation(fields: [workerId], references: [id])

  @@unique([workerId, verificationType])
  @@map("kyc_verifications")
}

model KycAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workerId    String   @map("worker_id") @db.Uuid
  event       String
  provider    String?
  performedBy String?  @map("performed_by") @db.Uuid
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")
  worker      Worker   @relation(fields: [workerId], references: [id])

  @@map("kyc_audit_logs")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  workerId        String?       @map("worker_id") @db.Uuid
  mode            BookingMode
  serviceType     String        @map("service_type")
  status          BookingStatus @default(pending)
  scheduledAt     DateTime?     @map("scheduled_at")
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  durationHours   Decimal?      @map("duration_hours")
  distanceKm      Decimal?      @map("distance_km")
  baseAmount      Decimal?      @map("base_amount")
  surgeMultiplier Decimal?      @default(1.0) @map("surge_multiplier")
  hourlyRate      Decimal?      @map("hourly_rate")
  totalAmount     Decimal?      @map("total_amount")
  startOtp        String?       @map("start_otp")
  endOtp          String?       @map("end_otp")
  customerAddress String?       @map("customer_address")
  customerLat     Decimal?      @map("customer_lat") @db.Decimal(10, 7)
  customerLng     Decimal?      @map("customer_lng") @db.Decimal(10, 7)
  ratingByUser    Int?          @map("rating_by_user")
  reviewText      String?       @map("review_text")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id])
  worker          Worker?       @relation(fields: [workerId], references: [id])
  payment         Payment?

  @@map("bookings")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @unique @map("booking_id") @db.Uuid
  amount            Decimal
  platformFee       Decimal       @default(0) @map("platform_fee")
  workerPayout      Decimal       @default(0) @map("worker_payout")
  paymentMethod     String?       @map("payment_method")
  razorpayOrderId   String?       @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  cashfreeOrderId   String?       @map("cashfree_order_id")
  cashfreeSessionId String?       @map("cashfree_session_id")
  youpiPaymentId    String?       @map("youpi_payment_id")
  youpiOrderId      String?       @map("youpi_order_id")
  utr               String?       @map("utr")
  status            PaymentStatus @default(pending)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  booking           Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model WorkerPayout {
  id                 String       @id @default(uuid()) @db.Uuid
  workerId           String       @map("worker_id") @db.Uuid
  amount             Decimal
  weekStartDate      DateTime     @map("week_start_date")
  weekEndDate        DateTime     @map("week_end_date")
  status             PayoutStatus @default(pending)
  processedAt        DateTime?    @map("processed_at")
  razorpayPayoutId   String?      @map("razorpay_payout_id")
  cashfreeTransferId String?      @map("cashfree_transfer_id")
  youpiPayoutId      String?      @map("youpi_payout_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  worker             Worker       @relation(fields: [workerId], references: [id])

  @@map("worker_payouts")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}
